# Prototype server environment (docs/deploy.md). Copy to .env on the server and fill in; never commit .env.
# Every variable the app reads is listed, without values. Notes give the recommended production setting.
# Empty = the built-in default (core/config.py).

# --- Required -------------------------------------------------------------------------------------------------------
LIVE=                       # 1: real provider calls (the server)
LLM_PROVIDER=               # gemini (free tier; Claude is never used unless set to claude)
JUDGE=                      # jev
JEV_API_KEY=                # paid; capped by JEV_DAILY_MAX_REQUESTS
GEMINI_API_KEY=             # free tier
GROQ_API_KEY=               # free tier (overflow judging, Prompt Guard)
DEMO_EMAIL_TO=              # every email goes to this address only (required: the API will not start without it)

# --- Spending and abuse limits ----------------------------------------------------------------------------------------
JEV_DAILY_MAX_REQUESTS=     # e.g. 300 (default); 0 = no Jev calls (judging falls back to the free route)
CLAUDE_DAILY_MAX_REQUESTS=  # e.g. 0 on the server (default 20); Claude is paid
UPLOAD_RATE_PER_HOUR=       # uploads per client address per hour (default 20)
UPLOAD_MAX_MB=              # per file (default 10)
PROXY_MAX_BODY_MB=          # whole request at the proxy (default 21 = 2 × UPLOAD_MAX_MB + 1)

# --- Email (outbox stores only; smtp sends to DEMO_EMAIL_TO) ------------------------------------------------------------
EMAIL_PROVIDER=             # outbox | smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=              # an app password for a demo mailbox, not your main password
REPLY_INBOX=                # imap to read replies, else empty
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_MINUTES=
WORKFLOW_TICK_SECONDS=      # background tick (reminders, nudges, inbox); runs in the API process only

# --- Other keys (optional) -------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=          # leave empty on the server
GITHUB_TOKEN=               # raises GitHub API limits for candidate repos

# --- Pools and percentiles --------------------------------------------------------------------------------------------
MIN_POOL=                   # 5 for the demo (shows percentiles with few candidates)
MIN_GROUP=                  # 2 for the demo
PEER_MIN_RATE=

# --- Models and routes (defaults are tuned; change only with a reason) --------------------------------------------------
JEV_MODEL=
JEV_CONFIDENCE_THRESHOLD=
JEV_MAX_CONCURRENCY=
JEV_PARSE_BATCH=
GEMINI_EXTRACT_MODEL=
GEMINI_JUDGE_MODEL=
GEMINI_COMPLEXITY_MODEL=
GEMINI_PLAN_MODEL=
GEMINI_EMAIL_MODEL=
GEMINI_REPLY_MODEL=
GEMINI_FEEDBACK_MODEL=
GEMINI_THINKING_LEVEL=
GEMINI_TIMEOUT_S=
GEMINI_CONCURRENCY=
GEMINI_LIMITS=
GEMINI_RPM=
GEMINI_TPM=
GEMINI_RPD=
GROQ_CONCURRENCY=
GROQ_TIMEOUT_S=
GROQ_TPM=
GROQ_REASONING_EFFORT=
JOB_EXTRACT_MODEL=
WEIGHTS_MODEL=               # weight assistant (specs/21); default: the plan route
WEIGHT_DIM_MIN=              # 5: smallest suggested dimension weight (of 100)
WEIGHT_DIM_MAX=              # 60: largest suggested dimension weight
WEIGHT_STEP=                 # 5: suggested weights are multiples of this
MARKET_EXTRACT_MODEL=
MARKET_MERGE_MODEL=
MARKET_SUMMARY_MODEL=
MODEL_LIMITS=
MODEL_CAPS=
MODEL_CONCURRENCY=
CLAUDE_MAX_CONCURRENCY=
JUDGE_CONCURRENCY=
MAX_PARALLEL_JUDGE_CALLS=
EXTRACT_EFFORT=
JUDGE_EFFORT=
COMPLEXITY_EFFORT=
PLAN_EFFORT=
TASK_MAX_TOKENS=
TASK_TIMEOUT_S=
OVERLOAD_COOLDOWN_S=
UNUSABLE_REST_S=
ROUTE_BUSY_BUDGET_S=
ROUTE_MAX_ATTEMPTS=
ROUTE_MAX_TOTAL_WAIT_S=
ROUTE_MAX_WAIT_S=
ROUTE_OVERLOAD_RETRY_ROUNDS=   # 1 (default): one more round when every model of a route was overloaded (503)
# ROUTE_<TASK>= overrides one route's model list (extract_document, extract_web, judge_single, judge_grouped, plan)

# --- Feature flags (defaults are the decided ones) ----------------------------------------------------------------------
PARSE_LINKEDIN=
REMOVE_HIDDEN_TEXT=
PROMPT_GUARD=
PROMPT_GUARD_MODELS=
PROMPT_GUARD_THRESHOLD=
SCORE_AUDIT=                # 1 (default): the Computation block under each score; 0 hides it
PARSER_MAX_UNCLEAR=

# --- Market baselines and job matching ----------------------------------------------------------------------------------
WINDOW_DAYS=
RECOMPUTE_DAYS=
REQ_SHARE=
PREF_SHARE=
MARGIN=
JOBMATCH_PREVIEW=
JOBMATCH_CLOSE=
JOBMATCH_STRONG=

# --- Hiring workflow timing ---------------------------------------------------------------------------------------------
CLOSURE_DAYS=
LOW_ACTIVITY_DAYS=
NUDGE_DAYS=
REVIEWING_DAYS=

# --- Set by docker-compose.prod.yml; do not set here --------------------------------------------------------------------
# RIGHTSTAFF_DB, RIGHTSTAFF_UPLOADS, TRUST_PROXY, REQUIRE_DEMO_EMAIL_TO
# --- Development and tests only; never on the server --------------------------------------------------------------------
# RIGHTSTAFF_DEPS_FACTORY, RIGHTSTAFF_TODAY, PRINT_TIMINGS
