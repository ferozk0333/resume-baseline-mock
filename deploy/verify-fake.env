# Local check of docker-compose.prod.yml on fakes (docs/deploy.md, "Verify locally"): no model calls, outbox email.
RIGHTSTAFF_DEPS_FACTORY=tests.ui_fakes:make_deps
LIVE=0
EMAIL_PROVIDER=outbox
DEMO_EMAIL_TO=demo@example.org
JOB_EXTRACT_FAKE=1
MIN_POOL=5
MIN_GROUP=2
UPLOAD_RATE_PER_HOUR=0          # every browser test uploads from one address; the server keeps the default (20)
