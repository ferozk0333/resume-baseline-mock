ANTHROPIC_API_KEY=                     
JEV_API_KEY=                     
GITHUB_TOKEN=                     # optional, raises GitHub rate limits
LLM_PROVIDER=claude                   # claude | gemini: provider for extraction, fallback judging, complexity, plan
GEMINI_API_KEY=                       # Google AI Studio key (free tier: prompts may be reviewed by Google; no personal data)
# GEMINI_RPM=10                       # set from aistudio.google.com/rate-limit (per model); RPD resets midnight Pacific
# GEMINI_TPM=250000
# GEMINI_RPD=250
GROQ_API_KEY=                         # optional: use models as groq/<id>, e.g. EXTRACT_MODEL=groq/openai/gpt-oss-120b
# GROQ_CONCURRENCY=2                  # optional: concurrent Groq requests
# GROQ_TPM=8000                       # optional: your Groq tier's tokens per minute (free tier: 8000)
JUDGE=jev                             # jev | claude
EXTRACT_MODEL=claude-haiku-4-5-20251001
JUDGE_FALLBACK_MODEL=claude-haiku-4-5-20251001
REASONING_MODEL=claude-sonnet-5-5     # improvement plan (and complexity unless COMPLEXITY_MODEL is set)
COMPLEXITY_MODEL=                     # optional; defaults to REASONING_MODEL
JEV_MODEL=jev-1.13.0                  # pinned Jev version; saved judgments are matched on it
JEV_CONFIDENCE_THRESHOLD=0.5          # Jev confidence below this → Claude fallback; starting value, set in phase 8
# EXTRACT_EFFORT=                    # optional effort per purpose: low | medium | high (empty = model default;
# JUDGE_EFFORT=                      #   only models that support effort, not Haiku 4.5)
# COMPLEXITY_EFFORT=
# PLAN_EFFORT=
# JUDGE_CONCURRENCY=48                # optional: judgments in flight across the graph (Jev + Claude)
# JEV_MAX_CONCURRENCY=32               # optional: concurrent Jev requests (Jev allows 80/s)
# CLAUDE_MAX_CONCURRENCY=12            # optional: concurrent Claude requests; lower on 429 errors
# RIGHTSTAFF_DB=rightstaff.db         # optional DB path override
# PRINT_TIMINGS=1                     # optional: timing table on stdout after each run
# RIGHTSTAFF_TODAY=2026-01-31         # optional "today" override for tests
# EMAIL_MODEL=                        # recruiter email drafts (default Haiku 4.5; gemini: Flash-Lite); template if unavailable
EMAIL_PROVIDER=outbox                 # outbox (stored, shown on the Outbox page, nothing leaves) | smtp
DEMO_EMAIL_TO=you@example.com    # demo redirect: every email goes here only; empty turns it off
# SMTP_HOST=smtp.gmail.com            # smtp only; Gmail needs an app password
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# JOB_EXTRACT_MODEL=gemini/gemini-3.8-flash   # reads job descriptions (create job); manual form if unavailable
# --- Hiring workflow (specs/16) ---
# REPLY_MODEL=                        # reads candidate replies (default Haiku 4.5; gemini: Flash-Lite); code rules if unavailable
# FEEDBACK_MODEL=                     # summarizes interview scorecards (default Haiku 4.5; gemini: Flash-Lite); code summary if unavailable
# NUDGE_DAYS=3                        # no reply after this many days → a nudge is drafted (never sent without approval)
# WORKFLOW_TICK_SECONDS=60            # scheduled checks (nudges, interviews passed, inbox); 0 = off
REPLY_INBOX=none                      # none (paste replies on the workflow page) | imap (poll the demo inbox, read-only)
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=                          # default: SMTP_USER
# IMAP_PASSWORD=                      # default: SMTP_PASSWORD (Gmail app password)
# IMAP_POLL_MINUTES=3
# --- Market baselines (specs/15) ---
# MARKET_EXTRACT_MODEL=gemini/gemini-3.8-flash      # once per new posting (cached by text hash)
# MARKET_SUMMARY_MODEL=gemini/gemini-3.8-flash      # scope/complexity/description, once per role per version
# MARKET_MERGE_MODEL=gemini/gemini-3.5-flash-lite   # proposes merges for new names, in batches
# WINDOW_DAYS=90  RECOMPUTE_DAYS=30  REQ_SHARE=0.5  PREF_SHARE=0.2  MARGIN=0.05  MIN_COMPANIES=8  MIN_POSTINGS=20

# Candidate Home (specs/17): dummy JobMatch preview and its groups; recruiter activity signals
JOBMATCH_PREVIEW=1
JOBMATCH_STRONG=75
JOBMATCH_CLOSE=55
REVIEWING_DAYS=14
LOW_ACTIVITY_DAYS=30
CLOSURE_DAYS=14

# Routing (specs/18): real provider calls only with LIVE=1 (make live sets it). Ordered failover lists per task,
# e.g. ROUTE_JUDGE_SINGLE="gemini/gemini-3.5-flash-lite,groq/openai/gpt-oss-120b"; a claude-… id on top works too.
# LIVE=1
# ROUTE_EXTRACT_DOCUMENT= / ROUTE_EXTRACT_WEB= / ROUTE_JUDGE_SINGLE= / ROUTE_JUDGE_GROUPED= / ROUTE_PLAN=
# MODEL_LIMITS="provider/model=RPM/TPM/RPD/TPD,…"   MODEL_CONCURRENCY="provider/model=n,…"
# GEMINI_TIMEOUT_S=45  GROQ_TIMEOUT_S=20  ROUTE_MAX_ATTEMPTS=4  ROUTE_MAX_WAIT_S=5  HEDGE_AFTER_S=0
# TASK_MAX_TOKENS="judge_single=1024,complexity=2048,judge_grouped_base=512,judge_grouped_item=192,judge_grouped_max=4096,extract_web=4096"
