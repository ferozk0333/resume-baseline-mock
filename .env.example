ANTHROPIC_API_KEY=                     
JEV_API_KEY=                     
GITHUB_TOKEN=                     # optional, raises GitHub rate limits
JUDGE=jev                             # jev | claude
EXTRACT_MODEL=claude-haiku-4-5-20251001
JUDGE_FALLBACK_MODEL=claude-haiku-4-5-20251001
REASONING_MODEL=claude-sonnet-5-5     # improvement plan (and complexity unless COMPLEXITY_MODEL is set)
COMPLEXITY_MODEL=                     # optional; defaults to REASONING_MODEL
JEV_MODEL=jev-1.13.0                  # pinned Jev version; saved judgments are matched on it
JEV_CONFIDENCE_THRESHOLD=0.5          # Jev confidence below this → Claude fallback; starting value, set in phase 8
# MAX_PARALLEL_JUDGE_CALLS=48          # optional: judgments in flight across the graph
# JEV_MAX_CONCURRENCY=32               # optional: concurrent Jev requests (Jev allows 80/s)
# CLAUDE_MAX_CONCURRENCY=12            # optional: concurrent Claude requests; lower on 429 errors
# RIGHTSTAFF_DB=rightstaff.db         # optional DB path override
# RIGHTSTAFF_TODAY=2026-01-31         # optional "today" override for tests
